FoamFile
{
    format      ascii;
    class       dictionary;
    object      momentumTransport;
}

simulationType laminar;
laminar
{
    model               generalisedNewtonian;
    viscosityModel      CustomNuImplementACustom;
    printCoeffs         on;

    CustomNuImplementACustomCoeffs
    {
        nu_inf      1e-06;
        k           1e-03;
        n           0.6;
        gammaDotmin 1e-06;
    }
}
