FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

libs            ("libSiskoGeneralisedNewtonian.so");
application     simpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         50000;
deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      0;

writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
