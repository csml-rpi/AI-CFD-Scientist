{
  "templates": {
    "journal": {
      "name": "Journal Article",
      "description": "Standard journal article format for CFD publications",
      "template_file": "latex_template.tex",
      "document_class": "article",
      "page_limit": 12,
      "sections": [
        "abstract",
        "introduction", 
        "methodology",
        "results_discussion",
        "conclusion",
        "bibliography"
      ],
      "subsections": {
        "methodology": [
          "problem_definition",
          "simulation_setup", 
          "computational_domain",
          "boundary_conditions",
          "numerical_methods"
        ]
      },
      "placeholders": {
        "TITLE_PLACEHOLDER": "title",
        "ABSTRACT_PLACEHOLDER": "abstract",
        "INTRODUCTION_PLACEHOLDER": "introduction",
        "PROBLEM_DEFINITION_PLACEHOLDER": "problem_definition",
        "SIMULATION_SETUP_PLACEHOLDER": "simulation_setup",
        "COMPUTATIONAL_DOMAIN_PLACEHOLDER": "computational_domain",
        "BOUNDARY_CONDITIONS_PLACEHOLDER": "boundary_conditions",
        "NUMERICAL_METHODS_PLACEHOLDER": "numerical_methods",
        "RESULTS_DISCUSSION_PLACEHOLDER": "results_discussion",
        "CONCLUSION_PLACEHOLDER": "conclusion",
        "BIBLIOGRAPHY_PLACEHOLDER": "bibliography"
      }
    },
    "conference": {
      "name": "NeurIPS 2024 Conference Paper",
      "description": "NeurIPS 2024 conference paper format with sophisticated formatting",
      "template_file": "conference_template.tex",
      "document_class": "article",
      "page_limit": 8,
      "sections": [
        "abstract",
        "introduction",
        "methodology", 
        "results_discussion",
        "conclusion",
        "bibliography"
      ],
      "subsections": {
        "methodology": [
          "problem_definition",
          "simulation_setup",
          "computational_domain", 
          "boundary_conditions",
          "numerical_methods"
        ]
      },
      "placeholders": {
        "TITLE_PLACEHOLDER": "title",
        "ABSTRACT_PLACEHOLDER": "abstract",
        "INTRODUCTION_PLACEHOLDER": "introduction",
        "PROBLEM_DEFINITION_PLACEHOLDER": "problem_definition",
        "SIMULATION_SETUP_PLACEHOLDER": "simulation_setup",
        "COMPUTATIONAL_DOMAIN_PLACEHOLDER": "computational_domain",
        "BOUNDARY_CONDITIONS_PLACEHOLDER": "boundary_conditions",
        "NUMERICAL_METHODS_PLACEHOLDER": "numerical_methods",
        "RESULTS_DISCUSSION_PLACEHOLDER": "results_discussion",
        "CONCLUSION_PLACEHOLDER": "conclusion",
        "BIBLIOGRAPHY_PLACEHOLDER": "bibliography"
      }
    },
    "technical_report": {
      "name": "Technical Report",
      "description": "Detailed technical report format",
      "template_file": "latex_template.tex",
      "document_class": "article",
      "page_limit": 20,
      "sections": [
        "abstract",
        "introduction",
        "literature_review",
        "methodology",
        "results_discussion",
        "conclusion",
        "appendix",
        "bibliography"
      ],
      "subsections": {
        "methodology": [
          "problem_definition",
          "simulation_setup",
          "computational_domain",
          "boundary_conditions", 
          "numerical_methods",
          "validation"
        ]
      },
      "placeholders": {
        "TITLE_PLACEHOLDER": "title",
        "ABSTRACT_PLACEHOLDER": "abstract",
        "INTRODUCTION_PLACEHOLDER": "introduction",
        "PROBLEM_DEFINITION_PLACEHOLDER": "problem_definition",
        "SIMULATION_SETUP_PLACEHOLDER": "simulation_setup",
        "COMPUTATIONAL_DOMAIN_PLACEHOLDER": "computational_domain",
        "BOUNDARY_CONDITIONS_PLACEHOLDER": "boundary_conditions",
        "NUMERICAL_METHODS_PLACEHOLDER": "numerical_methods",
        "RESULTS_DISCUSSION_PLACEHOLDER": "results_discussion",
        "CONCLUSION_PLACEHOLDER": "conclusion",
        "BIBLIOGRAPHY_PLACEHOLDER": "bibliography"
      }
    }
  },
  "default_template": "conference",
  "figure_formats": {
    "single_column": "\\begin{figure}[H]\n\\centering\n\\includegraphics[width=0.8\\textwidth]{FIGURE_PATH}\n\\caption{FIGURE_CAPTION}\n\\label{fig:FIGURE_LABEL}\n\\end{figure}",
    "two_column": "\\begin{figure*}[H]\n\\centering\n\\includegraphics[width=0.9\\textwidth]{FIGURE_PATH}\n\\caption{FIGURE_CAPTION}\n\\label{fig:FIGURE_LABEL}\n\\end{figure*}",
    "subfigures": "\\begin{figure}[H]\n\\centering\n\\begin{subfigure}[b]{0.48\\textwidth}\n\\includegraphics[width=\\textwidth]{FIGURE_PATH_1}\n\\caption{FIGURE_CAPTION_1}\n\\label{fig:FIGURE_LABEL_1}\n\\end{subfigure}\n\\hfill\n\\begin{subfigure}[b]{0.48\\textwidth}\n\\includegraphics[width=\\textwidth]{FIGURE_PATH_2}\n\\caption{FIGURE_CAPTION_2}\n\\label{fig:FIGURE_LABEL_2}\n\\end{subfigure}\n\\caption{MAIN_CAPTION}\n\\label{fig:FIGURE_LABEL_MAIN}\n\\end{figure}"
  },
  "table_formats": {
    "standard": "\\begin{table}[H]\n\\centering\n\\caption{TABLE_CAPTION}\n\\label{tab:TABLE_LABEL}\n\\begin{tabular}{TABLE_COLUMNS}\n\\toprule\nTABLE_HEADER\n\\midrule\nTABLE_CONTENT\n\\bottomrule\n\\end{tabular}\n\\end{table}"
  },
  "equation_formats": {
    "inline": "$EQUATION$",
    "display": "\\begin{equation}\nEQUATION\n\\label{eq:EQUATION_LABEL}\n\\end{equation}",
    "align": "\\begin{align}\nEQUATION_1 \\\\\nEQUATION_2\n\\label{eq:EQUATION_LABEL}\n\\end{align}"
  }
}
